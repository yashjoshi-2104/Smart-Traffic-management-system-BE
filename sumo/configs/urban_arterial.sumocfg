<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="../networks/urban_arterial.net.xml"/>
        <route-files value="../routes/urban_arterial.rou.xml,../routes/urban_emergency.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

<processing>
    <time-to-teleport value="-1"/>
    <ignore-route-errors value="true"/>
    <ignore-junction-blocker value="600"/>  <!-- ADD THIS LINE -->
    <collision.action value="teleport"/>
    <collision.mingap-factor value="0"/>
</processing>

    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
        <verbose value="false"/>
        <error-log value="sumo_errors.log"/>
    </report>

</configuration>
